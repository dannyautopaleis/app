{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@svgs/*": ["/assets/svgs/*"],
    },
    "noImplicitAny": false,
    "typeRoots": [
      "./@types",
      "@types",
      "./node_modules/@types/*",
      "./node_modules/@types"
    ]
  }
}
